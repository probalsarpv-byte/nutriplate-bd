{
  "expo": {
    "name": "NutriPlate BD",
    "slug": "nutriplate-bd",
    "version": "1.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "nutriplate",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#173C34"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.nutriplate.bd"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#173C34"
      },
      "package": "com.nutriplate.bd",
      "versionCode": 2,
      "permissions": [
        "RECEIVE_BOOT_COMPLETED"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-sqlite",
      "expo-asset"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "ccc8ef2e-8f62-4ae5-93f2-0e41301c91b9"
      }
    },
    "owner": "probal420"
  }
}
